// mboss-database/prisma/schema.prisma  — the mboss.dev cloud database ("the disk").
// The waitlist is a communication channel, not a gate: no accounts, no invites, no keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"   // no url here — Prisma 7 (P1012); connection via prisma.config.ts
}

enum SubscriberStatus {
  subscribed
  paused
  unsubscribed
  bounced
}

// How the subscriber got here. Only "email" (self-serve signup) exists today; "admin"
// reserves manual adds without a future enum migration.
enum SubscriberSource {
  email
  admin
}

enum BroadcastStatus {
  draft
  sending
  sent
  failed
}

// pending rows are the broadcast's recipient snapshot — created with the Broadcast in one
// transaction, then flipped to a terminal status one at a time by the send worker.
enum DeliveryStatus {
  pending
  sent
  failed
  skipped
}

model Subscriber {
  id                      String              @id @default(cuid())
  email                   String              @unique
  status                  SubscriberStatus    @default(subscribed)
  source                  SubscriberSource    @default(email)
  // Bumping this revokes every outstanding manage link for this subscriber at once: a link
  // carries the version it was minted against, and verification rejects a stale one.
  tokenVersion            Int                 @default(1)
  confirmationEmailSentAt DateTime?
  pausedAt                DateTime?
  unsubscribedAt          DateTime?
  bouncedAt               DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  deliveries              BroadcastDelivery[]

  @@index([status, createdAt])
}

model Broadcast {
  id             String              @id @default(cuid())
  subject        String
  bodyMarkdown   String
  // Which subscriber statuses this broadcast goes to: subscribed, and optionally paused too.
  audience       SubscriberStatus[]
  teaserImageUrl String?
  status         BroadcastStatus     @default(draft)
  createdBy      String              // admin email from the M365 session (x-admin-actor)
  recipientCount Int?                // set atomically with the pending delivery rows at creation
  createdAt      DateTime            @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  deliveries     BroadcastDelivery[]

  @@index([createdAt])
}

model BroadcastDelivery {
  id           String         @id @default(cuid())
  broadcastId  String
  subscriberId String
  status       DeliveryStatus @default(pending)
  error        String?
  updatedAt    DateTime       @updatedAt   // creation time while pending; flip time thereafter
  broadcast    Broadcast      @relation(fields: [broadcastId], references: [id])
  subscriber   Subscriber     @relation(fields: [subscriberId], references: [id])

  @@unique([broadcastId, subscriberId])   // one row per recipient; the pending→terminal flip key for the DBOS send step
}
